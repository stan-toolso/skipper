# Backend
PORT=4000
DATABASE_URL=postgres://skipper:skipper@localhost:5432/skipper
# Optionnel : chemin d'un binaire Claude Code spécifique (sinon le SDK utilise celui qu'il embarque)
# CLAUDE_BIN=/usr/local/bin/claude
# Optionnel : clé (64 caractères hexadécimaux, `openssl rand -hex 32`) qui chiffre les secrets stockés en base
# (clé API, jeton OAuth). À défaut, une clé est générée dans WORKSPACES_ROOT/.secret-key.
# SKIPPER_SECRET_KEY=
# Dossier commun des workspaces : un sous-dossier par projet (défaut : ~/skipper-workspaces)
# WORKSPACES_ROOT=/chemin/vers/workspaces

# Frontend (préfixe VITE_ obligatoire)
# Optionnel : URL de l'API (défaut : même hôte que le front, port 4000)
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
