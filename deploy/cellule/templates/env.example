# Configuration du backend Skipper d'une cellule (/home/skipper/skipper/.env, jamais versionné).
# Rempli par deploy/cellule/install-skipper.sh ; les lignes « À RENSEIGNER » doivent l'être avant le premier démarrage.
PORT=4100
DATABASE_URL=__DATABASE_URL__
WORKSPACES_ROOT=/home/skipper/skipper-workspaces
SHELL=/bin/bash

# Adresses publiques (front et API sur le même domaine, nginx proxifie /graphql, /auth, /api…).
APP_URL=https://__DOMAIN__
API_URL=https://__DOMAIN__
VITE_GRAPHQL_URL=https://__DOMAIN__/graphql

# Google OAuth (console Google Cloud, client « application Web », URI de redirection https://__DOMAIN__/auth/google/callback).
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__

# Connexion GitHub par code : identifiant d'une OAuth App (vide = identifiant public du CLI GitHub ; none = désactivé).
GITHUB_CLIENT_ID=__GITHUB_CLIENT_ID__

# Conteneurs des projets.
SKIPPER_RUNNER_IMAGE=skipper-runner:latest
SKIPPER_RUNNER_MEMORY=1g
SKIPPER_RUNNER_CPUS=1

# Clé maîtresse du coffre : si absente, WORKSPACES_ROOT/.secret-key est utilisée (créée au premier démarrage).
# Pour une migration, reprendre la clé de l'ancienne installation (fichier .secret-key copié avec les workspaces).
# SKIPPER_SECRET_KEY=
