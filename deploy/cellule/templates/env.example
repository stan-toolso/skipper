# Configuration du backend Skipper d'une cellule (/home/skipper/skipper/.env, jamais versionné).
# Rempli par deploy/cellule/install-skipper.sh ; les lignes « À RENSEIGNER » doivent l'être avant le premier démarrage.
# Port de l'ancien service `skipper` ; les instances bleu/vert (skipper@blue, skipper@green) prennent celui de
# /etc/skipper/instance-<couleur>.env (4101, 4102). SKIPPER_DRAIN_TIMEOUT_MINUTES : drainage maximal (120 par défaut).
PORT=4100
DATABASE_URL=__DATABASE_URL__
WORKSPACES_ROOT=/home/skipper/skipper-workspaces
SHELL=/bin/bash

# Adresses publiques (front et API sur le même domaine, nginx proxifie /graphql, /auth, /api…).
APP_URL=https://__DOMAIN__
API_URL=https://__DOMAIN__
# Aperçus des branches : DNS *.apercu.__DOMAIN__ vers la cellule, certificat générique (défi DNS-01) et bloc nginx
# des aperçus (templates/nginx-previews.conf). Laisser vide tant que ce n'est pas en place.
PREVIEW_URL=
VITE_GRAPHQL_URL=https://__DOMAIN__/graphql

# Google OAuth (console Google Cloud, client « application Web », URI de redirection https://__DOMAIN__/auth/google/callback).
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__GOOGLE_CLIENT_SECRET__

# Connexion GitHub par code : identifiant d'une OAuth App (vide = identifiant public du CLI GitHub ; none = désactivé).
GITHUB_CLIENT_ID=__GITHUB_CLIENT_ID__

# Conteneurs des projets : image et limites par défaut (un projet peut fixer les siennes dans son formulaire).
# Mémoire : un conteneur est partagé par toutes les sessions du projet (≈ 250 Mo par CLI claude, plus npm ci, tsc,
# vite build, navigateur) ; 4g convient à une cellule de 32 Go.
SKIPPER_RUNNER_IMAGE=skipper-runner:latest
SKIPPER_RUNNER_MEMORY=4g
# Plafond CPU (--cpus) : laisser vide. Vide = aucun plafond, les cœurs sont partagés équitablement entre conteneurs.
# Un plafond à 1 bride tous les agents d'un projet sur un seul cœur (constaté le 30/10/2026 sur skipper-1 : 8 cœurs,
# conteneur bridé en permanence, builds de 5 à 10 min, pas de modèle 2 à 4 fois plus lents sous charge).
SKIPPER_RUNNER_CPUS=

# Clé maîtresse du coffre : si absente, WORKSPACES_ROOT/.secret-key est utilisée (créée au premier démarrage).
# Pour une migration, reprendre la clé de l'ancienne installation (fichier .secret-key copié avec les workspaces).
# SKIPPER_SECRET_KEY=
